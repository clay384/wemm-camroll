+# --- run.json lazy item loading -------------------------------------------
+# Every run.json embeds the full per-question result set.  For the 1167-question
+# suites that single array reaches ~460 MB, and parsing all of them eagerly kept
+# ~20 GB resident even while idle, which is what pushed this process into the
+# kernel OOM killer.  The array is byte-skipped while reading metadata and
+# materialised from disk on first access.
+_RUN_ITEMS_MARK = b'\n  "items":'
+_RUN_ITEMS_CLOSE = b"\n  ]"
+_RUN_ITEMS_WS = b" \t\r\n"
+
+
+class LazyItems:
+    """Sequence view over a run's heavy ``items`` array, loaded on demand."""
+
+    __slots__ = ("_path", "_count", "_items")
+
+    def __init__(self, path, count):
+        self._path = path
+        self._count = int(count or 0)
+        self._items = None
+
+    def to_list(self) -> list:
+        if self._items is None:
+            items = []
+            try:
+                payload = json.loads(self._path.read_text(encoding="utf-8"))
+                if isinstance(payload, dict) and isinstance(payload.get("items"), list):
+                    items = payload["items"]
+            except (OSError, json.JSONDecodeError):
+                items = []
+            self._items = items
+        return self._items
+
+    def release(self) -> None:
+        """Drop the materialised copy so a long-lived process can reclaim it."""
+        self._items = None
+
+    # --- sequence protocol ---
+    def __len__(self):
+        return self._count
+
+    def __bool__(self):
+        return self._count > 0
+
+    def __iter__(self):
+        return iter(self.to_list())
+
+    def __getitem__(self, index):
+        return self.to_list()[index]
+
+    def __setitem__(self, index, value):
+        self.to_list()[index] = value
+
+    def __delitem__(self, index):
+        del self.to_list()[index]
+        self._count = len(self._items)
+
+    def __contains__(self, value):
+        return value in self.to_list()
+
+    def __eq__(self, other):
+        if isinstance(other, LazyItems):
+            return list(self) == list(other)
+        return self.to_list() == other
+
+    def __hash__(self):
+        return id(self)
+
+    def __repr__(self):
+        return f"<LazyItems count={self._count}>"
+
+    # --- list mutation: resume() rehydrates a proxy into a live BenchmarkRun ---
+    def append(self, value):
+        self.to_list().append(value)
+        self._count = len(self._items)
+
+    def extend(self, values):
+        self.to_list().extend(values)
+        self._count = len(self._items)
+
+    def insert(self, index, value):
+        self.to_list().insert(index, value)
+        self._count = len(self._items)
+
+    def pop(self, index=-1):
+        v = self.to_list().pop(index)
+        self._count = len(self._items)
+        return v
+
+    def remove(self, value):
+        self.to_list().remove(value)
+        self._count = len(self._items)
+
+    def clear(self):
+        self.to_list().clear()
+        self._count = 0
+
+    def sort(self, **kwargs):
+        self.to_list().sort(**kwargs)
+
+    def reverse(self):
+        self.to_list().reverse()
+
+    # --- copy support: never duplicate the payload, just re-point at disk ---
+    def __copy__(self):
+        return LazyItems(self._path, self._count)
+
+    def __deepcopy__(self, memo):
+        clone = LazyItems(self._path, self._count)
+        memo[id(self)] = clone
+        return clone
+
+
+def _json_default(value):
+    """Teach json.dumps how to emit a LazyItems proxy."""
+    if isinstance(value, LazyItems):
+        return value.to_list()
+    raise TypeError(f"Object of type {type(value).__name__} is not JSON serializable")
