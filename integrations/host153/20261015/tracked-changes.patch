+def load_run_state(path: Path):
+    """Return ``(state, item_count)`` for a run.json without parsing ``items``.
+
+    ``run.json`` is written by ``json.dumps(..., indent=2)``, so string values
+    never contain a literal newline.  That makes the first ``\n  ]`` after the
+    array opener an unambiguous end-of-array marker for the top-level array.
+    """
+    data = path.read_bytes()
+    mark = data.find(_RUN_ITEMS_MARK)
+    if mark < 0:
+        state = json.loads(data.decode("utf-8"))
+        items = state.get("items")
+        return state, len(items) if isinstance(items, list) else 0
+    tail = data[mark + len(_RUN_ITEMS_MARK):]
+    probe = tail.lstrip(_RUN_ITEMS_WS)
+    if not probe.startswith(b"["):
+        state = json.loads(data.decode("utf-8"))
+        items = state.get("items")
+        return state, len(items) if isinstance(items, list) else 0
+    bracket = mark + len(_RUN_ITEMS_MARK) + (len(tail) - len(probe))
+    cursor = bracket + 1
+    while cursor < len(data) and data[cursor:cursor + 1] in _RUN_ITEMS_WS:
+        cursor += 1
+    if data[cursor:cursor + 1] == b"]":
+        count = 0
+        end = cursor + 1
+    else:
+        close = data.index(_RUN_ITEMS_CLOSE, bracket)
+        count = data.count(b"\n    {", bracket, close)
+        end = close + len(_RUN_ITEMS_CLOSE)
+    state = json.loads((data[:bracket] + b"[]" + data[end:]).decode("utf-8"))
+    return state, count
+
