+class _LockedCursor:
+    """Cursor proxy that keeps every sqlite3 call under the store lock.
+
+    Fetching also advances shared connection state, so ``fetch*`` / iteration
+    must be serialized exactly like ``execute`` itself.
+    """
+
+    __slots__ = ("_cursor", "_lock")
+
+    def __init__(self, cursor, lock):
+        object.__setattr__(self, "_cursor", cursor)
+        object.__setattr__(self, "_lock", lock)
+
+    def fetchone(self):
+        with self._lock:
+            return self._cursor.fetchone()
+
+    def fetchmany(self, size=None):
+        with self._lock:
+            if size is None:
+                return self._cursor.fetchmany()
+            return self._cursor.fetchmany(size)
+
+    def fetchall(self):
+        with self._lock:
+            return self._cursor.fetchall()
+
+    def close(self):
+        with self._lock:
+            return self._cursor.close()
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        with self._lock:
+            return next(self._cursor)
+
+    def __getattr__(self, name):
+        return getattr(self._cursor, name)
+
+
+class _LockedConnection:
+    """Serialize access to a sqlite3 connection shared across threads.
+
+    ``check_same_thread=False`` only disables sqlite3's thread-affinity check;
+    it does not make a connection thread-safe.  CPython's ``_sqlite3`` keeps an
+    internal prepared-statement cache keyed by ``(sql,)`` and a per-connection
+    error slot, both mutated without a lock.  Concurrent ``execute()`` calls on
+    one shared connection therefore raise spurious ``KeyError((sql,))`` or
+    ``DatabaseError('not an error')``, and can leave a half-stepped statement
+    behind ("another row available", "cannot start a transaction within a
+    transaction").  Every operation is routed through the store lock instead.
+    """
+
+    __slots__ = ("_conn", "_lock")
+
+    def __init__(self, connection, lock):
+        object.__setattr__(self, "_conn", connection)
+        object.__setattr__(self, "_lock", lock)
+
+    # Attribute passthrough: row_factory / isolation_level / text_factory ...
+    def __getattr__(self, name):
+        return getattr(self._conn, name)
+
+    def __setattr__(self, name, value):
+        setattr(self._conn, name, value)
+
+    def execute(self, *args, **kwargs):
+        with self._lock:
+            return _LockedCursor(self._conn.execute(*args, **kwargs), self._lock)
+
+    def executemany(self, *args, **kwargs):
+        with self._lock:
+            return _LockedCursor(self._conn.executemany(*args, **kwargs), self._lock)
+
+    def executescript(self, *args, **kwargs):
+        with self._lock:
+            return _LockedCursor(self._conn.executescript(*args, **kwargs), self._lock)
+
+    def cursor(self, *args, **kwargs):
+        with self._lock:
+            return _LockedCursor(self._conn.cursor(*args, **kwargs), self._lock)
+
+    def commit(self):
+        with self._lock:
+            return self._conn.commit()
+
+    def rollback(self):
+        with self._lock:
+            return self._conn.rollback()
+
+    def close(self):
+        with self._lock:
+            return self._conn.close()
+
+
